{
  "name": "@obinexusltd/erlang-polycall",
  "version": "1.0.0",
  "description": "Erlang NIF binding for the Polycall C library (binding ABI v1, polycall >= 1.1.0).",
  "keywords": [
    "erlang",
    "otp",
    "nif",
    "polycall",
    "ffi"
  ],
  "homepage": "https://github.com/obinexus/erlang-polycall#readme",
  "bugs": {
    "url": "https://github.com/obinexus/erlang-polycall/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/erlang-polycall.git"
  },
  "license": "MIT",
  "author": {
    "name": "Nnamdi Michael Okpala",
    "email": "okpalan@protonmail.com"
  },
  "type": "commonjs",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./src/*": "./src/*",
    "./c_src/*": "./c_src/*",
    "./include/*": "./include/*",
    "./test/*": "./test/*",
    "./examples/*": "./examples/*",
    "./config": "./erlang-polycallrc",
    "./manifest": "./polycall-binding.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/",
    "c_src/",
    "include/",
    "test/",
    "examples/",
    "tests/",
    "scripts/",
    "Makefile",
    "rebar.config",
    "polycall-binding.json",
    "erlang-polycallrc",
    "README.md",
    "TODO.md",
    "LICENSE"
  ],
  "directories": {
    "example": "examples",
    "lib": "src",
    "test": "test"
  },
  "scripts": {
    "build": "make nif",
    "clean": "make clean",
    "test": "make test",
    "test:linux": "sh scripts/test-linux.sh",
    "test:package": "node tests/package.test.js",
    "verify": "make verify-dry",
    "prepack": "node tests/package.test.js"
  },
  "engines": {
    "node": ">=18",
    "npm": ">=9"
  },
  "publishConfig": {
    "access": "public"
  }
}
