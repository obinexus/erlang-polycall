{
  "name": "erlang-polycall",
  "version": "1.0.0",
  "package": "@obinexusltd/erlang-polycall",
  "language": "Erlang",
  "repository": "https://github.com/obinexus/erlang-polycall",
  "adapter": true,
  "ffi": true,
  "mechanism": "NIF (dirty I/O schedulers) linked against libpolycall via pkg-config",
  "core": "polycall >= 1.1.0 (binding ABI 1)",
  "core_repository": "https://github.com/obinexus/polycall",
  "config": "erlang-polycallrc",
  "entrypoint": "src/erlang_polycall.erl",
  "modules": ["src/erlang_polycall.erl", "src/polycall_peer.erl", "src/erlang_polycall_nif.erl"],
  "nativeAdapter": "c_src/erlang_polycall.c",
  "nif": "c_src/erlang_polycall_nif.c",
  "build": "make nif (or rebar3 compile)",
  "test": "sh scripts/test-linux.sh",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>"
}
