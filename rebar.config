%% erlang-polycall -- rebar3 project.
%% The NIF (priv/erlang_polycall_nif.so) is built by `make nif`, which links
%% libpolycall through `pkg-config polycall` (polycall >= 1.1.0, ABI v1).
{erl_opts, [debug_info, warnings_as_errors]}.
{minimum_otp_vsn, "21.2"}.   % persistent_term, enif_schedule_nif from dirty NIFs

{pre_hooks, [{"(linux|darwin|solaris|freebsd|netbsd|openbsd)", compile, "make nif"}]}.
{post_hooks, [{"(linux|darwin|solaris|freebsd|netbsd|openbsd)", clean, "make clean"}]}.

{eunit_opts, [verbose]}.
